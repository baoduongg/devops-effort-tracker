rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Read by /api/ai/answer-query (server route, no Firebase Auth session available)
    // to build the grounding snapshot it feeds to the AI.
    match /members/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /tasks/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /alarms/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /projects/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /taskChangeLogs/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Written by /api/ai/answer-query and /api/ai/format-entry (same server-route
    // no-auth-session constraint) to log every chat turn.
    match /chatLogs/{id} {
      allow read, write: if true;
    }
    match /chatThreads/{id} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
