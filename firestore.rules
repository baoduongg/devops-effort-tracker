// DEV-ONLY PERMISSIVE RULESET — DO NOT USE IN PRODUCTION.
// Tighten before any real deployment: restrict reads/writes by auth uid,
// validate role-based access (leader vs devops), and validate document shape.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
