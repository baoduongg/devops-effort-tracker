# Firebase (client config — safe to expose, restricted by Firebase security rules)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# NVIDIA build.nvidia.com API key (https://build.nvidia.com, format: nvapi-...)
NVIDIA_API_KEY=nvapi-your-key

# ChatOps (Mattermost) notification on task creation — server-side only, never expose as NEXT_PUBLIC_*
CHAT_OPS_URL_FOR_POSTS=https://chat.example.com/api/v4/posts
MM_AUTHTOKEN=your-mm-auth-token
MM_CSRF=your-mm-csrf-token
FROM_USER_ID=your-bot-user-id
CHANNEL_ID=target-channel-id
